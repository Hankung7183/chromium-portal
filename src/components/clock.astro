---
import "./clock.css";
---

<div class="clock">
    <div class="time"></div>
    <div class="date"></div>
</div>

<script>
    const element = document.querySelector(".date");
    if (element) {
        element.textContent = new Date().toLocaleDateString("en-US", {
            weekday: "long",
            month: "long",
            day: "numeric",
        });
    }
</script>

<script>
    const updateTime = (e: Element) => {
        const time = new Date().toLocaleTimeString("en-US", {
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
        });
        if (time !== e.textContent) {
            e.textContent = time;
        }
    };

    const element = document.querySelector(".time");
    if (element) {
        updateTime(element);
        const interval = setInterval(() => updateTime(element), 1000);
        window.addEventListener("beforeunload", () => clearInterval(interval));
    }
</script>
